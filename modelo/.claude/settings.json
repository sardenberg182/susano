{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Susano",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull --ff-only)",
      "Bash(git pull --ff-only *)",
      "Bash(git fetch *)",
      "Bash(git push -u origin *)",
      "Bash(gh auth status)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr status *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(python3 scripts/brain.py *)"
    ],
    "ask": [
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/scripts/**)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/CONVENCOES.md)",
      "Edit(/SUSANO.md)",
      "Edit(/CONTRIBUTING.md)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git restore *)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Edit(/00_susano/**)",
      "Edit(/00_pessoal/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/_privado/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push -u origin main)",
      "Bash(git push -u origin main *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run.sh\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/sessao_inicio.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run.sh\" --bloqueante \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guarda_prompt.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run.sh\" --bloqueante \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guarda_conteudo.py\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
